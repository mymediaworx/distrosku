<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xsd:include schemaLocation="../CigaretteeFileTypes.xsd"/>
	<xsd:include schemaLocation="../../CommonSO/efileTypes.xsd"/>
	<xsd:include schemaLocation="../../CommonSO/StateeFileTypes.xsd"/>
	<xsd:annotation>
		<xsd:documentation>
			<Description>Uniform Transaction Schedule</Description>
			<MaturityLevel>Draft Release</MaturityLevel>
			<ReleaseDate>April 1, 2013</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>
	<xsd:element name="SchPack" type="PackScheduleType">
		<xsd:annotation>
			<xsd:documentation>Physical inventory of all cigarettes including saleable and unsaleable cigarettes in your possession </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="PackScheduleType">
		<xsd:sequence>
			<xsd:element name="BegInventory" type="PackInventoryType">
				<xsd:annotation>
					<xsd:documentation>Beginning inventory of packs (from last month's ending inventory)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:choice>
				<xsd:element name="InventoryAdj" type="PackInventoryAdjType">
					<xsd:annotation>
						<xsd:documentation>Adjustments to inventory</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="NoAdjustments" type="CheckboxType">
					<xsd:annotation>
						<xsd:documentation>No adjustments to report</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="EndingInventory" type="PackInventoryType">
				<xsd:annotation>
					<xsd:documentation>Ending inventory of packs</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<!--Inventory Adjustment detail-->
	<xsd:complexType name="PackInventoryAdjType">
		<xsd:annotation>
			<xsd:documentation>Used to report the ending inventory details</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="ReportingJurisdictionStickCnt" type="IntegerType">
				<xsd:annotation>
					<xsd:documentation>Reporting jurisdiction stick count check figure</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="OtherJurisdictionStickCount" type="IntegerType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Other jurisdiction stick count check figure</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Details" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="CigInventoryType">
							<xsd:sequence>
								<xsd:element name="TypeOfAdj" type="CigAdjustmentType"/>
							</xsd:sequence>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PackInventoryType">
		<xsd:annotation>
			<xsd:documentation>Used to report inventory details</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="ReportingJurisdictionStickCnt" type="IntegerType">
				<xsd:annotation>
					<xsd:documentation>Reporting jurisdiction stick count check figure</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="OtherJurisdictionStickCount" type="IntegerType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Other jurisdiction stick count check figure</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Details" type="CigInventoryType" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
